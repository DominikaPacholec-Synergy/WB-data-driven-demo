{
  "defaultMode": "dark",
  "base": {
    "--ax-colors-acc1-500": "#c026d3",
    "--ax-colors-acc1-600": "#a21caf",
    "--ax-colors-acc1-400": "#e879f9",
    "--wb-font-family": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, monospace",
    "--ax-token-radius-shell": "2px",
    "--ax-token-radius-node-head": "0px",
    "--ax-public-node-width": "21rem",
    "--wb-transition": "0s"
  },
  "light": {
    "--ax-ui-bg-tertiary-default": "#f6f2fb",
    "--ax-ui-bg-primary-default": "#ffffff",
    "--ax-ui-bg-secondary-default": "#efe7f7",
    "--ax-ui-stroke-primary-default": "#ded0ec",
    "--ax-node-bg-primary-default": "#ffffff",
    "--ax-node-bg-secondary-default": "#f3ebfa",
    "--ax-node-stroke-primary-default": "#c9b4de",
    "--ax-txt-primary-default": "#1b0f24",
    "--ax-txt-secondary-default": "#5b476b",
    "--ax-edge-primary-default": "#9b7ab5"
  },
  "dark": {
    "--ax-ui-bg-tertiary-default": "#0c0812",
    "--ax-ui-bg-primary-default": "#160f1f",
    "--ax-ui-bg-secondary-default": "#211730",
    "--ax-ui-stroke-primary-default": "#33234a",
    "--ax-node-bg-primary-default": "#1b1226",
    "--ax-node-bg-secondary-default": "#271a37",
    "--ax-node-stroke-primary-default": "#3d2957",
    "--ax-txt-primary-default": "#f2e9fb",
    "--ax-txt-secondary-default": "#b49bcb",
    "--ax-edge-primary-default": "#6b4f8a"
  },
  "inspector": [
    {
      "label": "Brand",
      "controls": [
        { "token": "--ax-colors-acc1-500", "label": "Brand", "kind": "color", "bucket": "base" },
        { "token": "--ax-colors-acc1-600", "label": "Brand hover", "kind": "color", "bucket": "base" }
      ]
    },
    {
      "label": "Surfaces",
      "controls": [
        { "token": "--ax-ui-bg-tertiary-default", "label": "Canvas", "kind": "color", "bucket": "mode" },
        { "token": "--ax-ui-bg-primary-default", "label": "Panels", "kind": "color", "bucket": "mode" },
        { "token": "--ax-node-bg-primary-default", "label": "Node fill", "kind": "color", "bucket": "mode" },
        { "token": "--ax-node-stroke-primary-default", "label": "Node border", "kind": "color", "bucket": "mode" },
        { "token": "--ax-edge-primary-default", "label": "Edges", "kind": "color", "bucket": "mode" },
        { "token": "--ax-txt-primary-default", "label": "Text", "kind": "color", "bucket": "mode" }
      ]
    },
    {
      "label": "Shape",
      "controls": [
        {
          "token": "--ax-token-radius-shell",
          "label": "Panel radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 28,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--ax-token-radius-node-head",
          "label": "Node radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 24,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--ax-public-node-width",
          "label": "Node width",
          "kind": "length",
          "unit": "rem",
          "min": 12,
          "max": 26,
          "step": 0.25,
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Type & motion",
      "controls": [
        {
          "token": "--wb-font-family",
          "label": "Font",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "IBM Plex Mono", "value": "\"IBM Plex Mono\", ui-monospace, monospace" },
            { "label": "Inter", "value": "\"Inter\", system-ui, sans-serif" },
            { "label": "Poppins", "value": "\"Poppins\", system-ui, sans-serif" }
          ]
        },
        {
          "token": "--wb-transition",
          "label": "Motion",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "Instant", "value": "0s" },
            { "label": "Snappy", "value": "100ms ease-in" },
            { "label": "Smooth", "value": "160ms cubic-bezier(0.2, 0, 0, 1)" },
            { "label": "Lazy", "value": "420ms cubic-bezier(0.2, 0, 0, 1)" }
          ]
        }
      ]
    }
  ]
}
